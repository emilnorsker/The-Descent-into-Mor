│   │   └── has_status()
│   │
│   ├── components.material.gd
│   │   ├── is_flammable: bool
│   │   ├── is_slippery: bool
│   │   ├── material_type: String
│   │   ├── get_is_flammable()
│   │   ├── get_is_slippery()
│   │   └── get_material_type()
│   │
│   ├── weight_component.gd
│   │   ├── weight: float
│   │   ├── affects_balance: bool
│   │   ├── balance_penalty: float
│   │   ├── get_weight()
│   │   ├── get_affects_balance()
│   │   ├── get_balance_penalty()
│   │   └── get_movement_penalty()
│   │
│   ├── equipment_component.gd
│   │   ├── equipped_items: Dictionary
│   │   ├── dropped_items: Array[Entity]
│   │   ├── equip_weapon()
│   │   ├── equip_armor()
│   │   ├── drop()
│   │   ├── has_item_in_slot()
│   │   ├── is_dropped()
│   │   ├── get_weapon_range()
│   │   ├── get_defense_bonus()
│   │   └── get_power_bonus()
│   │
│   ├── components.body.gd
│   │   ├── type: String
│   │   ├── parts: Dictionary
│   │   ├── wounds: Dictionary
│   │   ├── consciousness: float
│   │   ├── apply_wound()
│   │   ├── has_wound()
│   │   ├── get_wound_type()
│   │   └── get_part_data()
│   │
│   └── terrain_component.gd
│       ├── elevation: int
│       ├── surface_type: String
│       ├── blocks_sight: bool
│       ├── get_elevation()
│       ├── get_surface_type()
│       ├── blocks_line_of_sight()
│       ├── provides_high_ground()
│       └── get_movement_cost()

src/
└── entity.gd
    ├── grid_position: Vector2i
    ├── entity_name: String
    ├── blocks_movement: bool
    ├── type: EntityType
    ├── key: String
    ├── components: Dictionary
    ├── add_component()
    ├── get_component()
    ├── has_component()
    ├── move()
    ├── distance()
    └── blocks_movement()


